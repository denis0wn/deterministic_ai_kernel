# Deterministic AI Kernel — PRODUCTION PROFILE (roadmap §5)
# Vetted operational settings. Source via ops/run_production.sh — do not
# export ad-hoc combinations in production runs.
#
# Every value below was validated by live evidence in sessions 2026-08-14/15
# (R3–R9, SOAK, §4). Changing a value REQUIRES a full R9 benchmark rerun
# (tests/acceptance/run_benchmark.sh) before the change is considered
# accepted.

# ── Model endpoint (stack A — recommended by §4) ────────────────────────
export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://127.0.0.1:8081/v1}"
export OPENAI_MODEL="${OPENAI_MODEL:-/Users/denissmoliakov/Models/gemma4-reasoning}"
export OPENAI_MODEL_TASK_PLANNING="$OPENAI_MODEL"
export OPENAI_MODEL_CODING_ASSISTANT="$OPENAI_MODEL"
export OPENAI_MODEL_CRITIC="$OPENAI_MODEL"
export OPENAI_MODEL_VERIFIER="$OPENAI_MODEL"
export OPENAI_MODEL_FINALIZER="$OPENAI_MODEL"
export OPENAI_API_KEY="${OPENAI_API_KEY:-mlx-local}"

# ── LLM transport (R6/R7) ────────────────────────────────────────────────
# Streaming ON: idle timeout decides stalls, not total duration (R6).
export DAK_LLM_STREAMING="${DAK_LLM_STREAMING:-on}"
# Idle window: no chunks (content/reasoning/keepalive) for this long =>
# STALL_DETECTED. 45s validated in R6 live runs.
export DAK_LLM_IDLE_TIMEOUT_SECS="${DAK_LLM_IDLE_TIMEOUT_SECS:-45}"
# Hard cap on total request duration even when chunks flow (true infinite
# generation). 300s validated in R6/R7.
export DAK_LLM_REQUEST_TIMEOUT_SECS="${DAK_LLM_REQUEST_TIMEOUT_SECS:-300}"
# Stall recovery: abort the stalled connection and retry on a fresh one,
# at most this many times (R7 EXP B proved disconnect frees the server).
export DAK_LLM_STALL_RETRIES="${DAK_LLM_STALL_RETRIES:-1}"
# Sequential by default (deterministic baseline); raise to 2-3 only after
# an R9 rerun (R7 concurrency validation exists, §4 reconfirms stack A).
export DAK_LLM_MAX_CONCURRENT="${DAK_LLM_MAX_CONCURRENT:-1}"

# ── MLX lifecycle (P0) ───────────────────────────────────────────────────
# Auto-unload after idle; keeps ~6 GB off the resident set when unused.
export MLX_IDLE_TIMEOUT_SECS="${MLX_IDLE_TIMEOUT_SECS:-120}"
export MLX_LIFECYCLE="${MLX_LIFECYCLE:-on}"

# ── Grounding & RAG (HD-2/R5/R8) ─────────────────────────────────────────
# RAG ON when DAK_RAG_DIR points at a non-empty KB dir; unset = OFF with
# byte-identical pre-R8 behavior (validated by the R8 compat matrix).
export DAK_RAG_DIR="${DAK_RAG_DIR:-$DAK_OPS_ROOT/../tests/acceptance/kb}"
export DAK_RAG_TOP_K="${DAK_RAG_TOP_K:-3}"

# ── CodeFix (P2/P3) ──────────────────────────────────────────────────────
# Authorized workspace for apply_patch_v1; MUST be set for any CodeFix
# task; the benchmark runner sets it per codefix case.
# export DAK_CODEFIX_WORKSPACE=/path/to/workspace
