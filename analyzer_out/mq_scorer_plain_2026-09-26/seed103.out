FINAL_ANSWER=```python
def average_score(scores):
    """Average of the non-None scores, as float.

    None entries are skipped. Empty input (or all-None) returns 0.0.
    Examples: [1.0, None, 3.0] -> 2.0; [] -> 0.0; [None] -> 0.0.
    """
    if not scores or all(score is None for score in scores):
        return 0.0
    filtered_scores = [score for score in scores if score is not None]
    return sum(filtered_scores) / len(filtered_scores)
